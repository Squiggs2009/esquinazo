# Copy to .env.local and adjust. Vite only exposes VITE_-prefixed values.

# API origin. In dev this is the proxy target (see vite.config.ts); in a
# production build it becomes the direct fetch origin.
VITE_API_BASE_URL=https://api.esquinazo.io

# Ko-fi page linked from the header and footer.
VITE_KOFI_URL=https://ko-fi.com/YOUR_KOFI

# Sanity project backing the Wire. The dataset is public on purpose - the
# content has to be crawlable - so there is no read token here and none is
# needed.
VITE_SANITY_PROJECT_ID=YOUR_PROJECT_ID
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

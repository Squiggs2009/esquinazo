{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    // Belt-and-suspenders alongside noEmit: the typecheck script overrides
    // noEmit to false (tsc -b's project-reference mode needs it to actually
    // run), and without an outDir that emits compiled .js straight into src/,
    // shadowing the real .tsx files - Vite's resolver picks the stray .js
    // over the .tsx it sits beside, silently serving stale compiled output
    // instead of current source. Mirrors tsconfig.node.json's own outDir.
    "outDir": "./node_modules/.tmp/tsconfig",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
